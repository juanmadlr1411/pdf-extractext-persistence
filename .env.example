# Aplicación
APP_NAME=pdf-extractext-persistence
APP_ENV=local
APP_PORT=8002

# MongoDB (MONGO_URI solo se acepta por variable de entorno)
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE_NAME=pdf_extractext
MONGO_COLLECTION_NAME=pdf_documents

# Consul
CONSUL_ENABLED=false
CONSUL_HTTP_ADDR=consul:8500
CONSUL_HTTP_TOKEN=token-de-desarrollo

# Registro del servicio (lo consume el cliente de Consul)
SERVICE_NAME=persistence
SERVICE_PORT=8002
SERVICE_HEALTH_PATH=/health/ready
